{
  "name": "agentic-bidding-room",
  "private": true,
  "version": "0.0.0",
  "description": "x402 Global Challenge PreHack — Agentic Bidding Room",
  "workspaces": [
    "api",
    "agent",
    "contracts",
    "web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "dev:agent": "npm run start --workspace agent",
    "dev:web": "npm run dev --workspace web",
    "test:contract": "npm run test --workspace contracts",
    "compile:contract": "algokit compile py contracts/bidding_room/contract.py",
    "deploy:testnet": "tsx --env-file=.env scripts/deploy-testnet.ts",
    "test:e2e": "tsx --env-file=.env scripts/test-e2e.ts"
  }
}
