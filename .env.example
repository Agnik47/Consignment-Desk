# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security -- it belongs only on
# this device, never in the website/frontend. Do not commit the real .env.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional overrides -- defaults shown.
# SUPABASE_BUCKET=item-images
# SUPABASE_TABLE=items

# LOT_CAMERA_DEVICE=/dev/video0
# LOT_CAMERA_WIDTH=1920
# LOT_CAMERA_HEIGHT=1080
# LOT_WARMUP_FRAMES=20
# LOT_JPEG_QUALITY=92

# Where local captures and the offline retry queue (queue.db) are stored.
# LOT_DATA_DIR=./lot_data
