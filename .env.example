# Resource server (the side that RECEIVES payments) — api/
AVM_ADDRESS=
FACILITATOR_URL=https://facilitator.goplausible.xyz
API_PORT=4021

# Dev-only: same account's secret key. Used once to submit its own USDC
# opt-in (agent/src/optin.ts), and reused as the session-funding "dispenser"
# (api/src/chain.ts, Phase 2) — a deliberate MVP simplification, not app
# runtime config for the x402 side.
RESOURCE_SERVER_PRIVATE_KEY=

# Client / agent (the side that PAYS) — agent/
AVM_PRIVATE_KEY=
RESOURCE_SERVER_URL=http://localhost:4021

# Algod
ALGOD_URL=https://testnet-api.algonode.cloud

# Phase 7 — BiddingRoom contract on testnet.
# Produced by `npx tsx --env-file=.env scripts/deploy-testnet.ts`.
TREASURY_MNEMONIC=
BIDDING_ROOM_APP_ID=
BIDDING_ROOM_PRODUCT_ASA_ID=
BIDDING_ROOM_TREASURY_ADDRESS=
DEMO_TARGET_CENTS=2900
DEMO_TARGET_NONCE=
BID_STAKE_MICRO_USDC=100000

# Jetson capture pipeline — reads the `items` table (image + grading data)
# the Jetson writes to. Server-side only; never sent to the browser. Optional:
# if unset, the API falls back to the hardcoded demo product.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Jetson live camera stream (MJPEG, e.g. `python3 -m lot.stream` on the
# Jetson). Public — sent to the browser as-is via GET /api/room/:id so the
# Room page can render an "Inspect live" view; the browser connects to the
# Jetson directly, the API never proxies frames. LAN-only URL in practice.
# Optional: if unset, the "Inspect live" option is hidden.
JETSON_STREAM_URL=

# Jetson capture trigger — POST /api/listings appends ?item_id=LOT-NNN and
# POSTs here to capture a fresh photo for a new listing. Response is
# synchronous: { image_url, grade_card: { category, identified_as, condition,
# grader_confidence } }. The Jetson also writes this to its own Supabase
# `items` row under the same id, independent of this response. Required for
# POST /api/listings; if unset, that route returns JETSON_NOT_CONFIGURED.
# Verify reachability first: `curl http://<jetson-ip>:8081/health` should
# return `{"ok": true}` before troubleshooting /capture itself.
JETSON_CAPTURE_URL=
# Max time to wait for the Jetson's synchronous capture response (ms).
JETSON_CAPTURE_TIMEOUT_MS=30000
# Optional — only if the Jetson's own LOT_API_KEY is set. Sent as the
# X-API-Key header; omit both to skip auth entirely.
JETSON_CAPTURE_API_KEY=
